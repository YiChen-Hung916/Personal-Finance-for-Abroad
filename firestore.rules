rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================
    // Helper functions
    // =========================

    function signedIn() {
      return request.auth != null;
    }

    function userExists() {
      return signedIn()
        && exists(
          /databases/$(database)/documents/users/$(request.auth.uid)
        );
    }

    function currentUser() {
      return get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      );
    }

    function authorized() {
      return userExists()
        && currentUser().data.active == true
        && (
          currentUser().data.role == "owner" ||
          currentUser().data.role == "authorizedUser"
        );
    }

    function owner() {
      return authorized()
        && currentUser().data.role == "owner";
    }

    // Is this receipt assigned to the current user?
    function assignedToMe(receiptId) {
      return authorized()
        && get(
          /databases/$(database)/documents/receipts/$(receiptId)
        ).data.confirmationUserId == request.auth.uid;
    }


    // =========================
    // Users
    // =========================

    match /users/{uid} {

      // A signed-in user must be able to read their own
      // profile so the app can determine their role.
      //
      // Owners can read all user profiles.
      allow read: if signedIn()
              && (
                request.auth.uid == uid ||
                owner()
              );

      // Only an existing owner can manage user profiles.
      allow create, update, delete: if owner();
  }

    // =========================
    // Receipts
    // =========================

    match /receipts/{rid} {

      // ALL authorized users may view receipts.
      allow read: if authorized();

      // Only owners may create/edit/delete receipts.
      allow create, update, delete: if owner();


      // =========================
      // Receipt Items
      // =========================

      match /items/{iid} {

        // ALL authorized users may view receipt items.
        allow read: if authorized();

        // Only owners modify items.
        allow create, update, delete: if owner();
      }


      // =========================
      // Confirmations
      // =========================

      match /confirmations/{cid} {

        // Owner can see every confirmation.
        //
        // Authorized users can see their own confirmation
        // only when the receipt is assigned to them.
        allow read: if owner()
                    || (
                      authorized()
                      && request.auth.uid == cid
                      && assignedToMe(rid)
                    );

        // Only the designated confirmer may
        // create/update their confirmation.
        allow create, update: if authorized()
                              && request.auth.uid == cid
                              && assignedToMe(rid);

        // Only owner can delete confirmation records.
        allow delete: if owner();
      }
    }


    // =========================
    // Other collections
    // =========================

    // Temporary rule while other modules are being built.
    match /{document=**} {
      allow read, write: if owner();
    }
  }
}
