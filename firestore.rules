rules_version = '2';

service cloud.firestore {

  match /databases/{database}/documents {


    // ==================================================
    // Authentication
    // ==================================================

    function signedIn() {
      return request.auth != null;
    }


    // ==================================================
    // Authorized User
    // ==================================================

    function authorized() {

      return signedIn()

        && exists(
          /databases/$(database)/documents/users/$(request.auth.uid)
        )

        && get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.active == true

        && (
          get(
            /databases/$(database)/documents/users/$(request.auth.uid)
          ).data.role == "owner"

          ||

          get(
            /databases/$(database)/documents/users/$(request.auth.uid)
          ).data.role == "authorizedUser"
        );
    }


    // ==================================================
    // Owner
    // ==================================================

    function owner() {

      return signedIn()

        && exists(
          /databases/$(database)/documents/users/$(request.auth.uid)
        )

        && get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.active == true

        && get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.role == "owner";
    }


    // ==================================================
    // Receipt Assignment
    // ==================================================
    //
    // NEW:
    //
    // confirmationUserIds: [
    //   "uid_A",
    //   "uid_B"
    // ]
    //
    // LEGACY:
    //
    // confirmationUserId: "uid_A"
    //
    // A user is assigned when:
    //
    // 1. their UID appears in confirmationUserIds
    //
    // OR
    //
    // 2. this is an old Receipt without the array and
    //    confirmationUserId equals their UID.
    //
    // ==================================================

    function assignedToMe(receiptId) {

      let receipt =
        get(
          /databases/$(database)/documents/receipts/$(receiptId)
        ).data;


      return authorized()

        && (

          (
            receipt.confirmationUserIds is list

            &&

            request.auth.uid in
              receipt.confirmationUserIds
          )

          ||

          (
            !(
              receipt.confirmationUserIds is list
            )

            &&

            receipt.confirmationUserId ==
              request.auth.uid
          )
        );
    }


    // ==================================================
    // Users
    // ==================================================

    match /users/{uid} {

      // User may read own profile.
      allow get:
        if signedIn()
        && request.auth.uid == uid;


      // Owner may read/list all users.
      allow get, list:
        if owner();


      // Only Owner manages users.
      allow create, update, delete:
        if owner();
    }


    // ==================================================
    // Receipts
    // ==================================================

    match /receipts/{rid} {

      // ------------------------------------------------
      // Receipt read
      // ------------------------------------------------
      //
      // Keep current architecture:
      //
      // all authorized users may read Receipts.
      //
      // We can tighten receipt-level visibility later
      // as a separate checkpoint because Firestore
      // queries must match Security Rules.
      // ------------------------------------------------

      allow read:
        if authorized();


      // Only Owner may create/change/delete Receipts.
      allow create, update, delete:
        if owner();


      // =================================================
      // Receipt Items
      // =================================================

      match /items/{iid} {

        allow read:
          if authorized();


        allow create, update, delete:
          if owner();
      }


      // =================================================
      // Confirmations
      // =================================================

      match /confirmations/{cid} {

        // ----------------------------------------------
        // READ
        // ----------------------------------------------
        //
        // Owner:
        // may read every confirmation.
        //
        // Assigned confirmer:
        // may read confirmations belonging to the same
        // Receipt.
        //
        // This is necessary because A/B/C must be able
        // to determine whether ANY confirmer already
        // completed the Receipt.
        // ----------------------------------------------

        allow read:
          if owner()
          || assignedToMe(rid);


        // ----------------------------------------------
        // CREATE
        // ----------------------------------------------
        //
        // An assigned user may create ONLY the
        // confirmation document whose ID is their UID.
        //
        // A cannot create confirmations/B.
        // ----------------------------------------------

        allow create:
          if assignedToMe(rid)
          && request.auth.uid == cid;


        // ----------------------------------------------
        // UPDATE
        // ----------------------------------------------
        //
        // Keep the same ownership requirement.
        // ----------------------------------------------

        allow update:
          if assignedToMe(rid)
          && request.auth.uid == cid;


        // Only Owner can delete confirmations.
        allow delete:
          if owner();
      }
    }


    // ==================================================
    // Other Collections
    // ==================================================
    //
    // Existing owner-only fallback.
    // ==================================================

    match /{document=**} {

      allow read, write:
        if owner();
    }
  }
}
