rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================
    // Helper functions
    // =========================

    function signedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      );
    }

    function authorized() {
      return signedIn()
        && exists(
          /databases/$(database)/documents/users/$(request.auth.uid)
        )
        && userDoc().data.active == true
        && (
          userDoc().data.role == "owner" ||
          userDoc().data.role == "authorizedUser"
        );
    }

    function owner() {
      return authorized()
        && userDoc().data.role == "owner";
    }

    function assignedToMe(receiptId) {
      return authorized()
        && get(
          /databases/$(database)/documents/receipts/$(receiptId)
        ).data.confirmationUserId == request.auth.uid;
    }


    // =========================
    // USERS
    // =========================

    match /users/{uid} {

      // IMPORTANT:
      // Any authenticated Google user can read ONLY
      // their own profile.
      //
      // This allows the frontend to determine whether
      // the account is authorized.
      allow get: if signedIn()
                 && request.auth.uid == uid;

      // Owners may list/read user profiles for
      // Authorized User management.
      allow list: if owner();

      // Owner can read another individual user profile.
      allow get: if owner();

      // Only existing owners manage authorization.
      allow create, update, delete: if owner();
    }


// ==================================================
// Cards
// ==================================================

match /cards/{cardId} {

  // All authorized users may read card information.
  // This is needed later when reviewing receipts.
  allow read: if authorized();

  // Only owners may manage cards.
  allow create, update, delete: if owner();
}


    // =========================
    // RECEIPTS
    // =========================

    match /receipts/{rid} {

      // Every authorized user may view receipts.
      allow read: if authorized();

      // Only Owner creates/edits/deletes receipts.
      allow create, update, delete: if owner();


      // -------------------------
      // Receipt Items
      // -------------------------

      match /items/{iid} {

        // Every authorized user may view items.
        allow read: if authorized();

        // Only Owner modifies items.
        allow create, update, delete: if owner();
      }


      // -------------------------
      // Confirmations
      // -------------------------

      match /confirmations/{cid} {

        // Owner sees all confirmations.
        //
        // Authorized user sees their confirmation
        // only for a receipt assigned to them.
        allow read: if owner()
                    || (
                      authorized()
                      && request.auth.uid == cid
                      && assignedToMe(rid)
                    );

        // Only the designated confirmer can
        // create/update their confirmation.
        allow create, update: if authorized()
                              && request.auth.uid == cid
                              && assignedToMe(rid);

        allow delete: if owner();
      }
    }


    // =========================
    // OTHER COLLECTIONS
    // =========================

    // Temporary while other V1 modules are built.
    // Owner has access; authorizedUser does not.
    match /{document=**} {
      allow read, write: if owner();
    }
  }
}
