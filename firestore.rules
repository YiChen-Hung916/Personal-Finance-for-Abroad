rules_version = '2';

service cloud.firestore {

  match /databases/{database}/documents {


    // ==================================================
    // Authentication
    // ==================================================

    function signedIn() {
      return request.auth != null;
    }


    // ==================================================
    // Authorized User
    // ==================================================

    function authorized() {

      return signedIn()

        && exists(
          /databases/$(database)/documents/users/$(request.auth.uid)
        )

        && get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.active == true

        && (
          get(
            /databases/$(database)/documents/users/$(request.auth.uid)
          ).data.role == "owner"

          ||

          get(
            /databases/$(database)/documents/users/$(request.auth.uid)
          ).data.role == "authorizedUser"
        );
    }


    // ==================================================
    // Owner
    // ==================================================

    function owner() {

      return signedIn()

        && exists(
          /databases/$(database)/documents/users/$(request.auth.uid)
        )

        && get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.active == true

        && get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.role == "owner";
    }


    // ==================================================
    // Receipt Assignment
    // ==================================================

    function assignedToMe(receiptId) {

      let receipt =
        get(
          /databases/$(database)/documents/receipts/$(receiptId)
        ).data;


      let confirmationUserIds =
        receipt.get(
          "confirmationUserIds",
          []
        );


      let confirmationUserId =
        receipt.get(
          "confirmationUserId",
          null
        );


      return authorized()

        && (

          (
            confirmationUserIds is list

            &&

            request.auth.uid in
              confirmationUserIds
          )

          ||

          (
            confirmationUserIds.size() == 0

            &&

            confirmationUserId ==
              request.auth.uid
          )
        );
    }


    // ==================================================
    // Users
    // ==================================================

    match /users/{uid} {

      // Any authorized family member may read user
      // profiles so Transfer can show the family-member
      // receiver dropdown.
      allow get, list:
        if authorized();


      // Only Owner manages users.
      allow create, update, delete:
        if owner();
    }


    // ==================================================
    // Receipts
    // ==================================================

    match /receipts/{rid} {

      allow read:
        if authorized();


      allow create, update, delete:
        if owner();


      // =================================================
      // Receipt Items
      // =================================================

      match /items/{iid} {

        allow read:
          if authorized();


        allow create, update, delete:
          if owner();
      }


      // =================================================
      // Confirmations
      // =================================================

      match /confirmations/{cid} {

        allow read:
          if owner()
          || assignedToMe(rid);


        allow create:
          if assignedToMe(rid)
          && request.auth.uid == cid;


        allow update:
          if assignedToMe(rid)
          && request.auth.uid == cid;

// ------------------------------------------------
// OWNER RESOLVE TRANSFER MISMATCH
// ------------------------------------------------
//
// Owner may only change the three resolution fields.
// The original mismatch record remains unchanged.
// ------------------------------------------------

allow update:
  if owner()

  && resource.data.status ==
    "mismatch"


        allow delete:
          if owner();
      }
    }


    // ==================================================
    // Transfers
    // ==================================================

    match /transfers/{tid} {


      // ------------------------------------------------
      // READ
      // ------------------------------------------------
      //
      // Owner:
      // may read every Transfer.
      //
      // Sender / Receiver:
      // may read Transfers involving themselves.
      // ------------------------------------------------

      allow get, list:
        if authorized()

        && (
          owner()

          ||

          resource.data.senderUserId ==
            request.auth.uid

          ||

          resource.data.receiverUserId ==
            request.auth.uid
        );


      // ------------------------------------------------
      // CREATE
      // ------------------------------------------------
      //
      // Any authorized user may create a Transfer,
      // but:
      //
      // - sender must be the signed-in user
      // - receiver must be another active authorized user
      // - status must start as pending
      // - confirmation fields must start empty
      // ------------------------------------------------

      allow create:
        if authorized()

        && request.resource.data.senderUserId ==
          request.auth.uid

        && request.resource.data.createdBy ==
          request.auth.uid

        && request.resource.data.receiverUserId !=
          request.auth.uid

        && exists(
          /databases/$(database)/documents/users/$(request.resource.data.receiverUserId)
        )

        && get(
          /databases/$(database)/documents/users/$(request.resource.data.receiverUserId)
        ).data.active == true

        && (
          get(
            /databases/$(database)/documents/users/$(request.resource.data.receiverUserId)
          ).data.role == "owner"

          ||

          get(
            /databases/$(database)/documents/users/$(request.resource.data.receiverUserId)
          ).data.role == "authorizedUser"
        )

        && request.resource.data.amount is number

        && request.resource.data.amount > 0

        && request.resource.data.currency is string

        && request.resource.data.status ==
          "pending"

        && request.resource.data.confirmationStatus ==
          "pending"

        && request.resource.data.reportedAmount ==
          null

        && request.resource.data.confirmedBy ==
          null

        && request.resource.data.confirmedAt ==
          null

        && request.resource.data.transferMismatchResolved ==
          false

        && request.resource.data.transferMismatchResolvedAt ==
          null

        && request.resource.data.transferMismatchResolvedBy ==
          null;


      // ------------------------------------------------
      // UPDATE
      // ------------------------------------------------
      //
      // Only Receiver may confirm.
      //
      // Immutable:
      // sender / receiver / original amount / currency /
      // transfer date / creator.
      //
      // Allowed transition:
      //
      // pending
      //   -> received
      //   -> mismatch
      // ------------------------------------------------

      allow update:
        if authorized()

        && resource.data.receiverUserId ==
          request.auth.uid

        && resource.data.status ==
          "pending"

        && request.resource.data.senderUserId ==
          resource.data.senderUserId

        && request.resource.data.senderName ==
          resource.data.senderName

        && request.resource.data.receiverUserId ==
          resource.data.receiverUserId

        && request.resource.data.receiverName ==
          resource.data.receiverName

        && request.resource.data.transferDate ==
          resource.data.transferDate

        && request.resource.data.amount ==
          resource.data.amount

        && request.resource.data.currency ==
          resource.data.currency

        && request.resource.data.notes ==
          resource.data.notes

        && request.resource.data.createdBy ==
          resource.data.createdBy

        && request.resource.data.createdAt ==
          resource.data.createdAt

        && request.resource.data.transferMismatchResolved ==
          resource.data.transferMismatchResolved

        && request.resource.data.transferMismatchResolvedAt ==
          resource.data.transferMismatchResolvedAt

        && request.resource.data.transferMismatchResolvedBy ==
          resource.data.transferMismatchResolvedBy

        && request.resource.data.confirmedBy ==
          request.auth.uid

        && request.resource.data.confirmedAt !=
          null

        && (

          (
            request.resource.data.status ==
              "received"

            &&

            request.resource.data.confirmationStatus ==
              "match"

            &&

            request.resource.data.reportedAmount ==
              resource.data.amount
          )

          ||

          (
            request.resource.data.status ==
              "mismatch"

            &&

            request.resource.data.confirmationStatus ==
              "mismatch"

            &&

            request.resource.data.reportedAmount is number

            &&

            request.resource.data.reportedAmount >= 0
          )
        );


      // ------------------------------------------------
      // DELETE
      // ------------------------------------------------
      //
      // Keep destructive action Owner-only.
      // ------------------------------------------------

      allow delete:
        if owner();
    }


    // ==================================================
    // Other Collections
    //
    // Transfers already have their own explicit rules.
    // Do not let the Owner fallback bypass those rules.
    // ==================================================

    match /{collection}/{document=**} {

  allow read, write:
    if owner()
    && collection != "transfers";
}
  }
}
